{% extends 'base.html.twig' %}

{% block title %}Carrito{% endblock %}

{% block body %}
    <h1>Carrito</h1>

    {% if lineas is empty %}
        <p>Tu carrito esta vacio. <a href="{{ path('catalogo') }}">Ver el catalogo</a></p>
    {% else %}
        <table class="tabla">
            <thead>
                <tr><th>Producto</th><th>Precio</th><th>Cantidad</th><th>Subtotal</th><th></th></tr>
            </thead>
            <tbody>
                {% for linea in lineas %}
                    <tr>
                        <td><a href="{{ path('producto', {sku: linea.producto.sku}) }}">{{ linea.producto.nombre }}</a></td>
                        <td>{{ linea.producto.precioActual|cop }}</td>
                        <td>{{ linea.cantidad }}</td>
                        <td>{{ linea.subtotal|cop }}</td>
                        <td>
                            <form method="post" action="{{ path('carrito_quitar', {sku: linea.producto.sku}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('carrito') }}">
                                <button type="submit" class="secundario">Quitar</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr><th colspan="3">Total</th><th class="total">{{ total|cop }}</th><th></th></tr>
            </tfoot>
        </table>

        <p><a class="boton" href="{{ path('pedido') }}">Finalizar compra</a></p>
    {% endif %}
{% endblock %}
